{
  "name": "@auraimage/extension",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "type-check": "wxt prepare && tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen-icons": "node scripts/gen-icons.mts",
    "screenshots": "node scripts/screenshots.mts",
    "store-shots": "node scripts/store-shots.mts",
    "store-tiles": "node scripts/store-tiles.mts",
    "demo:images": "node scripts/demo-images.mts"
  },
  "dependencies": {
    "blurhash": "^2.0.5"
  },
  "devDependencies": {
    "@clack/prompts": "^0.9.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "geist": "^1.5.1",
    "prettier": "3.9.5",
    "puppeteer": "^25.3.0",
    "sharp": "^0.33.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.0.18",
    "wxt": "^0.20.27"
  }
}
