{
  "name": "@auraimage/extension",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node build.mts",
    "dev": "node build.mts --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "test": "vitest run",
    "test:smoke": "node tests/smoke/smoke.mts",
    "verify-dist": "node scripts/verify-dist.mts",
    "pack": "node scripts/pack.mts",
    "gen-icons": "node scripts/gen-icons.mts",
    "screenshots": "node scripts/screenshots.mts",
    "store-shots": "node scripts/store-shots.mts",
    "store-tiles": "node scripts/store-tiles.mts",
    "demo:images": "node scripts/demo-images.mts"
  },
  "dependencies": {
    "blurhash": "^2.0.5"
  },
  "devDependencies": {
    "@clack/prompts": "^0.9.1",
    "@eslint/js": "^9.39.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chrome": "^0.2.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "geist": "^1.5.1",
    "prettier": "3.9.5",
    "puppeteer": "^25.3.0",
    "sharp": "^0.33.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.0.18"
  }
}
